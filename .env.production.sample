# Used in vite's production build; amend to be wherever your backend server lives
VITE_SERVICE_URL=https://some.endpoint.org

# Used for auth services
VITE_AUTH_ENABLED=true
VITE_LOGIN_SERVICE=http://some.login.service
VITE_LOGOUT_SERVICE=http://some.login.service/logout

# Used to show crossmatch button
VITE_CROSSMATCH_ENABLED=true

# Configure web app title
VITE_ORGANIZATION_NAME="Simons Observatory" # optional
VITE_APP_NAME="Light Curve Viewer"

# Configure contact info in footer
VITE_CONTACT_EMAIL=

# Configure documentation link in footer
VITE_DOCS_LINK=